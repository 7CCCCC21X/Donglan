# 规则吃单 · 独立服务的设置（复制成 ruletaker.env 再填；不要把填好的文件提交到 GitHub）
# 每行 变量名=值，等号两边不要空格，值不要加引号。# 开头的行是说明。

# ---- 模式 ----
# off 关 / paper 只记录（按盘口记下会买到多少、按 Predict 结果结算，不下单）/ on 真实吃单
# 建议先 paper 跑一两天，看 /status 里的抢单记录和结算，再改 on
RULE_TAKER=paper
# 硬开关：只有不设置或写 on 才允许真实下单；紧急时改成 off 重启，服务就只能 paper
LIVE_TRADING_ALLOWED=on

# ---- Predict 账户（和 Railway 上 huice 的写法一样）----
# 规则吃单专用的 API Key（developers.predict.fun 再申请一个）。不要和 Railway 上正在用的 Key 共用：
# 每把 Key 每分钟 240 次，两个进程一起用会一起撞 429。
# 如果拿 Railway 上的 RULE_API_KEY 来用，请把 Railway 上的 RULE_API_KEY 删掉（否则那边会把它借给盘口和预挂）。
RULE_API_KEY=
# 没有专用 Key 时用这个（填一个就行，RULE_API_KEY 优先）
PREDICT_API_KEY=
# 备用 API Key（可选，最多到 RULE_API_KEY_9）：在用的那把被限流（429）时，同一个请求当场换下一把再发，不再整体停 20 秒。
# 最好是没有别的程序在用的 Key；/check 会逐把试一次，填错了当场说
RULE_API_KEY_2=
RULE_API_KEY_3=
# 签名钱包私钥（64 位十六进制，0x 可省）：网站账户填导出的 Privy 钱包私钥。
# 部署到虚拟机后会被自动收走、在那台机器上加密保存（设置文件里不再有明文）；以后换私钥：bash deploy/gcp/rt.sh key
PREDICT_PRIVATE_KEY=
# 网站账户（智能钱包）的充值地址；用普通钱包交易就留空
PREDICT_ACCOUNT=
# 56 = BNB 主网（默认）
PREDICT_CHAIN_ID=56
# 读余额、授权用的 BNB 链节点，空 = 公共节点
BSC_RPC_URL=

# ---- 规则（变量名、默认值和 huice 1.154.27 一样，Railway 上的值可以直接抄过来）----
# 每条规则的最高买价（¢），0 = 不做这条
RULE_GOLD_SHUT_CENTS=58
RULE_GOLD_OPEN_CENTS=50
RULE_GOLD_0515_CENTS=58
RULE_GOLD_0500_CENTS=0
RULE_GOLD_1645_CENTS=0
RULE_OIL_SHUT_CENTS=0
RULE_OIL_OPEN_CENTS=50
RULE_OIL_0045_CENTS=0
# 盘中吃单（开场后接着买，指数站在规则方向才买），0 = 不做；需要币安合约指数（BINANCE_BASE_URL / BINANCE_WS_URL）
RULE_GOLD_SHUT_LIVE_CENTS=0
RULE_GOLD_OPEN_LIVE_CENTS=0
# 黄金、原油各自的开关和每场最多买多少份
RULE_GOLD=on
RULE_OIL=on
RULE_GOLD_SHARES=50
RULE_OIL_SHARES=50
# 两个市场合计每天（北京时间）最多花多少美元，0 = 不限
RULE_MAX_DAY_USD=0
# 今天已结算亏损到这个数就停止开新单（只算本服务自己的盈亏），0 = 不限
RULE_MAX_DAILY_LOSS_USD=0
# 每秒检查时段（北京时间），可写多段：01:00-07:00,13:00-14:00；off = 不做
RULE_FAST_HOURS=01:00-07:00
# 对手提前多少分钟挂单（默认 300 = 5 小时）：每场在那一刻前后每秒检查、预先签好单；0 = 不按这个时刻
RULE_LEAD_MINUTES=300

# ---- Telegram（可选；怎么绑定见 README“Telegram：怎么绑定”）----
# 最简单：在 @BotFather 给本服务新建一个机器人，只填下面三行，通知和命令都走它：
#   TELEGRAM_COMMAND_TOKEN=新机器人的 Token   TELEGRAM_COMMANDS=on   ADMIN_USER_ID=你的数字用户 ID
# 命令：/menu 按钮菜单、/status 状态、/check 自检、/test 挂单测试、/pause、/resume、/mode、/id（只认 ADMIN_USER_ID 发的）
# 机器人没反应：bash deploy/gcp/rt.sh check 看 Telegram 那一行（会说原因）
TELEGRAM_COMMAND_TOKEN=
TELEGRAM_COMMANDS=off
ADMIN_USER_ID=0
# 想让通知发到别处（例如继续用 Railway 那个机器人发到原来的群话题）才填下面两行：
# 发通知的机器人 Token（只发消息，和 Railway 共用同一个 Token 不冲突；空 = 用上面的命令机器人发）
TELEGRAM_BOT_TOKEN=
# 发到哪里：私聊填用户 ID；群组话题写 群ID:话题ID；多个用逗号分开。空 = 发给 ADMIN_USER_ID 的私聊
TELEGRAM_CHAT_ID=
# 注意：不要把 Railway 机器人的 Token 填进 TELEGRAM_COMMAND_TOKEN——同一个 Token 只能有一个程序收命令
# 成交、结算通知；off 只发告警
RULE_NOTIFY=on

# ---- 状态页（默认只在本机 127.0.0.1:8080，用 deploy/gcp/rt.sh status 通过 SSH 看）----
STATUS_PORT=8080
STATUS_HOST=127.0.0.1
STATUS_KEY=

# ---- 高级（一般不用改）----
# 推送连接条数（1～3）：多开几条，谁先送到用谁的；Predict 若限制连接数就改回 1
RULE_WS_CONNECTIONS=1
# 每把 Key 每分钟最多发多少请求（Predict 上限 240）；Key 和别的进程共用时调低
PREDICT_RATE_PER_MIN=220
# 市场没写费率时按多少基点算
PREDICT_FEE_BPS=200
# 状态页显示的区域名（Google Cloud 上自动读，不用填）
RULE_REGION=
LOG_LEVEL=INFO
