[Unit]
Description=Rule taker for Predict.fun (规则吃单 · 独立服务)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=ruletaker
Group=ruletaker
WorkingDirectory=/var/lib/ruletaker
Environment=STATE_DB=/var/lib/ruletaker/ruletaker.sqlite3
# The service reads its settings file itself (inline comments allowed); the process environment above wins over it.
# (The Rust version; rt.sh python puts the Python version in instead: ruletaker.service.d/python.conf.)
ExecStart=/opt/ruletaker/bin/ruletaker run --env /etc/ruletaker/ruletaker.env
# The private key, kept encrypted on this machine (deploy/gcp/vm-key.sh: /etc/credstore.encrypted/predict_private_key, sealed
# with the machine's own key and its virtual TPM): systemd opens it for this service alone, into a directory of the service's
# own in memory ($CREDENTIALS_DIRECTORY: read by its user only, gone when it stops). None kept: nothing is loaded, and the
# settings file's PREDICT_PRIVATE_KEY is used as before.
LoadCredentialEncrypted=predict_private_key
Restart=always
RestartSec=3
# On a stop: the orders on their way get their answers (25 s at the most) and the resting rest is withdrawn, the records are
# written and the last messages sent — an ordinary stop takes a second; this is the worst case's room (a request hanging,
# Telegram unreachable), never cut short by a kill.
TimeoutStopSec=75
KillSignal=SIGTERM
# A little ahead of everything else on the machine when the race is on.
Nice=-5
LimitNOFILE=65536
# The process holds the signing key in memory: no core dump of it is ever written, and the files it makes are its own alone.
LimitCORE=0
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/ruletaker

[Install]
WantedBy=multi-user.target
